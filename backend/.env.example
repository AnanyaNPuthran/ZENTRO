# ─── Server Configuration ─────────────────────────────
PORT=3001

# ─── JWT Authentication Secret ─────────────────────────
# Generate a strong, secure random string for production
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES=30d

# ─── Gmail SMTP Service (Nodemailer) ───────────────────
# Use your Gmail address and a generated 16-character Google App Password
# Instructions: https://myaccount.google.com/apppasswords
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_16_char_google_app_password
